{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cotab-collaboration",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],
  "vars": {
    "COTAB_ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175"
  }
}
