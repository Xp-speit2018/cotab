{
  "name": "cotab",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:web && npm run build:web",
    "build:web": "vite build",
    "build:server": "npm --prefix server run build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:web && npm run typecheck:targets",
    "typecheck:web": "tsc -b",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:adapters:local": "tsc -p tsconfig.adapters.local.json --noEmit",
    "typecheck:adapters:web": "tsc -p tsconfig.adapters.web.json --noEmit",
    "typecheck:adapters": "npm run typecheck:adapters:local && npm run typecheck:adapters:web",
    "typecheck:cli": "tsc -p tsconfig.cli.json --noEmit",
    "typecheck:mcp": "tsc -p src/mcp/tsconfig.mcp.json --noEmit",
    "typecheck:targets": "npm run typecheck:core && npm run typecheck:adapters && npm run typecheck:cli && npm run typecheck:mcp",
    "verify:targets": "npm run typecheck:targets && npm run test:unit",
    "verify": "npm run typecheck && npm run test:unit && npm run check:action-docs && npm run check:scripts && npm run build:web && npm run build:server",
    "verify:all": "npm run verify && npm run check:desktop && npm run test:e2e",
    "check:desktop": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "check:scripts": "tsc --project scripts/tsconfig.scripts.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui-harness": "playwright test e2e/specs/ui-harness.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "audit:alphatab-fields": "tsx scripts/audit-alphatab-fields.ts --audit > docs/ALPHATAB-FIELD-AUDIT.tmp.md && tsx scripts/audit-alphatab-fields.ts --selection > docs/CORE-FIELD-SELECTION.tmp.md",
    "docs:actions": "tsx scripts/generate-document-actions.ts",
    "docs:actions:wiki": "tsx scripts/generate-actions-wiki.ts",
    "docs:server-api:wiki": "tsx scripts/generate-server-api-wiki.ts",
    "check:action-docs": "tsx scripts/generate-document-actions.ts --check",
    "mcp:dev": "tsx src/mcp/cli.ts",
    "cotab:cli": "tsx src/cli/cli.ts"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@coderline/alphatab-vite": "^1.8.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.8.6",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^11.1.1",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.22",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.8.9",
    "jsdom": "^28.1.0",
    "shadcn": "^3.8.4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  }
}
