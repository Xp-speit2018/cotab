{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,

    /* Strict */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* JSX */
    "jsx": "react-jsx",

    /* Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@tests/*": ["tests/*"]
    },

    /* Emit */
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/cotab/tsconfig.tsbuildinfo",
    "isolatedModules": true,
    "esModuleInterop": true,

    /* Test */
    "types": ["vitest/globals"]
  },
  "include": ["src", "vite-env.d.ts"],
  "exclude": ["src/adapters/local", "src/cli", "src/mcp", "src/**/__tests__"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
